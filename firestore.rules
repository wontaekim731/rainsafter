rules_version = '2';
// QLEAR 클라우드 규칙: Firebase 콘솔 → Firestore Database → 규칙(Rules)에 그대로 붙여 넣고 [게시]
service cloud.firestore {
  match /databases/{db}/documents {
    // 학원 코드 → 선생님. 로그인한 사람은 코드로 찾을 수 있고, 선생님 본인만 자기 코드를 만든다
    match /codes/{c} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.tid == request.auth.uid;
    }
    // 선생님 정보(학원 코드·그룹): 본인만
    match /teachers/{t} {
      allow read, write: if request.auth != null && request.auth.uid == t;
    }
    // 학생: 학생 본인이 쓰고, 연결된 선생님이 읽는다
    match /students/{s} {
      allow read: if request.auth != null && (request.auth.uid == s || resource.data.tid == request.auth.uid);
      allow create, update: if request.auth != null && request.auth.uid == s;
      allow delete: if request.auth != null && resource.data.tid == request.auth.uid;
      match /days/{d} {
        allow read: if request.auth != null && (request.auth.uid == s || get(/databases/$(db)/documents/students/$(s)).data.tid == request.auth.uid);
        allow write: if request.auth != null && request.auth.uid == s;
      }
    }
    // 과제: 선생님이 만들고, 받는 학생(targets)이 읽는다
    match /asg/{a} {
      allow read: if request.auth != null && (resource.data.tid == request.auth.uid || request.auth.uid in resource.data.targets);
      allow create: if request.auth != null && request.resource.data.tid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.tid == request.auth.uid;
    }
    // Q매치: 방(4자리)은 로그인한 사람이 읽고, 방장·도전자만 고친다. 빈 방에는 누구든 도전자로 들어갈 수 있다
    match /rooms/{r} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.host == request.auth.uid;
      allow update: if request.auth != null && (resource.data.host == request.auth.uid || resource.data.guest == request.auth.uid || (resource.data.guest == '' && request.resource.data.guest == request.auth.uid));
    }
    // 매치 기록: 이름·승무패·점수는 모두가 보고, 자기 것만 쓴다
    match /pubs/{u} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == u;
    }
    // 매치 알림: 보내는 사람(from)이 만들고, 받는 사람(to)과 보낸 사람만 읽고 지운다
    match /invs/{i} {
      allow read, delete: if request.auth != null && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid;
    }
  }
}
